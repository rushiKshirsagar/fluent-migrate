{
  "name": "fluent-migrate",
  "version": "1.1.0",
  "description": "Migrate a React app's CSS/SCSS colors to Fluent UI makeStyles + design tokens.",
  "keywords": [
    "fluentui",
    "fluent",
    "makeStyles",
    "griffel",
    "design-tokens",
    "codemod",
    "migration",
    "css",
    "scss"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "fluent-migrate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "tokens": "tsx scripts/generate-tokens.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "culori": "^4.0.2",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.6",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "@fluentui/react-theme": "^9.2.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
